{
  "manifest_version": 3,
  "name": "Christian's Download Any Image",
  "version": "1.0.0",
  "description": "Download the images you can't right-click and save: click the button, then click any image on the page.",
  "minimum_chrome_version": "126",
  "permissions": ["activeTab", "scripting", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Download next image I click on",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
